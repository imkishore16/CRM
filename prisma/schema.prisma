generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  name             String?
  organizationName String?
  email            String   @unique
  password         String?
  role             Role     @default(USER)
  avatar           String?
  provider         Provider
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  meetings           Meeting[]
  createdSpaces    Space[]  @relation("createdBy")
}

model Space {
  id     Int    @id @default(autoincrement())
  name   String
  modelProvider String @default("gemini")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Foreign Keys
  userId        Int
  
  // Relations
  user          User          @relation("createdBy", fields: [userId], references: [id], onDelete: Cascade)
  customers     SpaceCustomer[]
  conversations Conversation[]

  @@index([userId])
  @@index([name])
  
}

model SpaceCustomer {
  id                 Int                @id @default(autoincrement())
  mobileNumber       String
  conversationStatus ConversationStatus 
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

 // Foreign Keys
  spaceId            Int
  
  // Relations
  space              Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, mobileNumber]) // Prevent duplicate customers per space
  @@index([spaceId])
  @@index([mobileNumber])
}

model Conversation {
  id           Int      @id @default(autoincrement())
  content      String 
  sender       SenderType
  mobileNumber String
  
  createdAt    DateTime @default(now())
  
  // Foreign Keys
  spaceId      Int
  
  // Relations
  space        Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([mobileNumber])
  @@index([createdAt])
}

model Meeting {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  startTime   DateTime
  endTime     DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}


enum SenderType {
  USER
  BOT
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum CampaignStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
}

enum ConversationStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
}

enum Provider {
  Google
  Credentials
  Spotify
}

